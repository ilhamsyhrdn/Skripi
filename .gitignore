# Data mentah (1.5GB, hasil download Kaggle - jangan diredistribusi via git, ToS Kaggle & ukuran)
Dataset/

# Virtual environment & cache Python
Kodingan/.venv/
**/__pycache__/
*.pyc

# Checkpoint model terlatih (besar, bisa direproduksi ulang lewat src/training/train_cv.py)
Kodingan/outputs/models/*.pt

# Cache & log yang bisa dibuat ulang / tidak perlu di-diff
Kodingan/outputs/manifests/_fingerprint_cache.csv
Kodingan/outputs/logs/*.log

# Streamlit local state
.streamlit/
